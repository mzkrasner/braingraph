{
  "name": "braingraph",
  "version": "0.1.0",
  "description": "Agent-first, Markdown-native second-brain workspace scaffolding",
  "type": "module",
  "bin": {
    "braingraph": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bin.ts",
    "lint": "eslint --quiet --cache --cache-location node_modules/.cache/eslint/ --cache-strategy content src test scripts",
    "check-types": "tsc --noEmit",
    "test": "vitest run --silent",
    "test:coverage": "vitest run --coverage --silent",
    "format": "prettier --write --ignore-path .prettierignore .",
    "format:check": "prettier --check --ignore-path .prettierignore .",
    "check:portability": "tsx scripts/check-portability.ts",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "audit:dev": "pnpm audit --audit-level moderate",
    "qa": "pnpm lint && pnpm check-types && pnpm test:coverage && pnpm build && pnpm format:check && pnpm check:portability",
    "smoke": "node dist/bin.js --help",
    "smoke:package": "pnpm build && tsx scripts/smoke-package.ts",
    "prepack": "pnpm qa"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "templates/",
    "schemas/",
    "docs/",
    ".agents/skills/",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md"
  ],
  "keywords": [
    "agents",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "grok-build",
    "knowledge-management",
    "markdown",
    "obsidian",
    "qmd",
    "worktrees"
  ],
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-no-secrets": "^1.1.2",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "minimatch": "10.2.5"
    }
  },
  "license": "MIT"
}
