{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://braingraph.local/schemas/workspace.schema.json",
  "title": "Braingraph workspace",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "templateVersion",
    "workspace",
    "knowledge",
    "externalSystems",
    "repositories"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "templateVersion": { "type": "integer", "minimum": 1, "maximum": 1 },
    "workspace": {
      "type": "object",
      "required": [
        "name",
        "slug",
        "description",
        "scope",
        "sensitivity",
        "profiles"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "^.*\\S.*$"
        },
        "scope": {
          "enum": [
            "project",
            "organization",
            "professional-domain",
            "personal-domain",
            "mixed"
          ]
        },
        "sensitivity": {
          "enum": ["public", "private", "confidential", "regulated"]
        },
        "profiles": {
          "type": "array",
          "items": { "enum": ["knowledge", "software"] },
          "contains": { "const": "knowledge" },
          "uniqueItems": true
        }
      }
    },
    "knowledge": {
      "type": "object",
      "required": ["directory", "maintenance", "obsidian", "qmd"],
      "additionalProperties": false,
      "properties": {
        "directory": { "type": "string", "minLength": 1 },
        "maintenance": {
          "type": "object",
          "required": ["mode"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["proposal-first", "delegated"] },
            "delegatedScope": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": {
                "properties": { "mode": { "const": "delegated" } },
                "required": ["mode"]
              },
              "then": { "required": ["delegatedScope"] },
              "else": { "not": { "required": ["delegatedScope"] } }
            }
          ]
        },
        "obsidian": {
          "type": "object",
          "required": ["enabled", "vaultName"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "const": true },
            "vaultName": { "type": "string", "minLength": 1 }
          }
        },
        "qmd": {
          "type": "object",
          "required": ["enabled", "collection", "include"],
          "additionalProperties": false,
          "properties": {
            "enabled": { "const": true },
            "collection": { "type": "string", "minLength": 1 },
            "include": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "externalSystems": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalSystem" }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "externalSystem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "roles",
        "owns",
        "identifiers",
        "access",
        "freshness",
        "capture",
        "sensitivity",
        "fallback"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["active", "planned", "inactive"] },
        "url": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "source",
              "intake",
              "execution",
              "communication",
              "reference",
              "archive"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "owns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "identifiers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "access": {
          "type": "object",
          "required": ["read", "write"],
          "additionalProperties": false,
          "properties": {
            "read": { "enum": ["none", "manual", "connector"] },
            "write": { "enum": ["prohibited", "human-approval", "delegated"] }
          }
        },
        "writeScope": { "type": "string", "minLength": 1 },
        "freshness": {
          "enum": [
            "verify-live",
            "revision-tracked",
            "snapshot",
            "not-applicable"
          ]
        },
        "capture": {
          "enum": ["link", "summarize", "synchronize", "copy", "exclude"]
        },
        "sensitivity": {
          "enum": ["public", "private", "confidential", "regulated"]
        },
        "fallback": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "access": {
                "properties": { "write": { "const": "delegated" } },
                "required": ["write"]
              }
            }
          },
          "then": { "required": ["writeScope"] }
        },
        {
          "if": {
            "properties": {
              "access": {
                "properties": { "write": { "const": "delegated" } },
                "required": ["write"]
              }
            }
          },
          "else": { "not": { "required": ["writeScope"] } }
        }
      ]
    },
    "repository": {
      "type": "object",
      "required": [
        "url",
        "path",
        "integrationBranch",
        "stableWorktree",
        "branchPrefix"
      ],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "integrationBranch": { "type": "string", "minLength": 1 },
        "productionBranch": { "type": ["string", "null"] },
        "stableWorktree": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "branchPrefix": { "type": "string" }
      }
    }
  }
}
